#!/usr/bin/env node

import { createHash } from 'node:crypto'
import {
  createWriteStream,
  existsSync,
  lstatSync,
  mkdirSync,
  mkdtempSync,
  readFileSync,
  readdirSync,
  readlinkSync,
  renameSync,
  rmSync,
  statSync,
  symlinkSync,
  writeFileSync,
} from 'node:fs'
import { homedir, tmpdir } from 'node:os'
import { basename, dirname, join, resolve } from 'node:path'
import { spawnSync } from 'node:child_process'
import { createRequire } from 'node:module'
import { fileURLToPath } from 'node:url'
import { zstdDecompressSync } from 'node:zlib'
import { pipeline } from 'node:stream/promises'
import { detectDistributionMode, formatDistributionIdentity } from './distribution-identity.js'
import { verifyFileManifest } from './distribution-files.js'
import {
  findArtifactForPlatform,
  normalizePlatform,
  parseReleaseManifest,
} from './distribution-manifest.js'
import {
  acquireInstallLock,
  beginInstallTransaction,
  commitInstallTransaction,
  readInstallState,
  reconcileTransactions,
  rollbackToPreviousVersion,
} from './distribution-state.js'
import { profilePackageSpec } from './package-spec.js'

const require = createRequire(import.meta.url)
const packageRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..')
const manifest = JSON.parse(readFileSync(join(packageRoot, 'package.json'), 'utf8'))
const dshHome = resolve(process.env.DSH_HOME || join(homedir(), '.dsh'))
const omdConfigPath = join(dshHome, 'omd.json')
const RELEASE_MANIFEST_URL =
  process.env.OMD_MANIFEST_URL ||
  'https://github.com/amplifthq/oh-my-dsh/releases/latest/download/release-manifest.json'

function distributionContext() {
  return detectDistributionMode(packageRoot)
}
const presetCatalog = {
  memory: 'Local persistent knowledge graph via MCP Reference Memory',
  context7: 'Current library documentation through Context7 MCP',
  playwright: 'Browser automation through Playwright MCP',
}

const profiles = {
  omd: ['@deepseek-ai/dsh-base', '@deepseek-ai/dsh-web-app', 'oh-my-dsh'],
  'omd-headless': ['@deepseek-ai/dsh-base', '@deepseek-ai/dsh-headless', 'oh-my-dsh'],
}
const profilePluginDependencies = [
  '@deepseek-ai/dsh-lsp',
  '@deepseek-ai/dsh-tool-lsp',
  '@deepseek-ai/dsh-web-fetch-http',
  '@deepseek-ai/dsh-web-search-exa',
  '@deepseek-ai/dsh-web-search-perplexity',
]

function fail(message, code = 1) {
  console.error(`omd: ${message}`)
  process.exit(code)
}

function run(command, args, options = {}) {
  const result = spawnSync(command, args, {
    cwd: options.cwd || process.cwd(),
    env: process.env,
    stdio: 'inherit',
    shell: process.platform === 'win32',
  })
  if (result.error) fail(`${command} failed: ${result.error.message}`)
  return result.status ?? 1
}

function sourceCheckout() {
  return existsSync(join(packageRoot, '.git'))
}

function packageSpec() {
  return profilePackageSpec({
    sourceCheckout: sourceCheckout(),
    packageRoot,
    version: manifest.version,
  })
}

function resolveInstallRoot(mode) {
  if (process.env.OMD_INSTALL_ROOT) return resolve(process.env.OMD_INSTALL_ROOT)
  if (mode.mode !== 'portable' || !mode.distributionRoot) return null
  const parent = dirname(mode.distributionRoot)
  if (basename(parent) === 'versions') return dirname(parent)
  return null
}

function portableNodeModulesTarget(mode) {
  const installRoot = resolveInstallRoot(mode)
  if (installRoot) return resolve(installRoot, 'current', 'app', 'node_modules')
  return resolve(mode.distributionRoot, 'app', 'node_modules')
}

function writeCordisPatch(directory) {
  const patchPath = join(directory, 'cordis.patch.yml')
  if (!existsSync(patchPath)) {
    writeFileSync(
      patchPath,
      [
        '# Your local overrides for the oh-my-dsh profile.',
        '# This file is preserved across `omd setup` upgrades.',
        '[]',
        '',
      ].join('\n'),
    )
  }
}

function linkPortableNodeModules(directory, target) {
  const nodeModulesPath = join(directory, 'node_modules')
  if (existsSync(nodeModulesPath)) {
    const info = lstatSync(nodeModulesPath)
    if (info.isSymbolicLink()) {
      rmSync(nodeModulesPath)
    } else {
      rmSync(nodeModulesPath, { recursive: true, force: true })
    }
  }
  symlinkSync(target, nodeModulesPath)
}

function writeProfile(name, bundles) {
  const directory = join(dshHome, 'profiles', name)
  mkdirSync(directory, { recursive: true })

  const packagePath = join(directory, 'package.json')
  let current = {}
  if (existsSync(packagePath)) {
    try {
      current = JSON.parse(readFileSync(packagePath, 'utf8'))
    } catch (error) {
      fail(`cannot parse ${packagePath}: ${error.message}`)
    }
  }

  const next = {
    ...current,
    name: `dsh-profile-${name}`,
    private: true,
    type: 'module',
    dependencies: {
      ...(current.dependencies || {}),
      'oh-my-dsh': packageSpec(),
      ...Object.fromEntries(
        profilePluginDependencies.map((dependency) => [
          dependency,
          manifest.dependencies[dependency],
        ]),
      ),
    },
    dsh: {
      ...(current.dsh || {}),
      profile: {
        ...(current.dsh?.profile || {}),
        bundles,
      },
    },
  }
  writeFileSync(packagePath, `${JSON.stringify(next, null, 2)}\n`)

  writeCordisPatch(directory)

  console.log(`omd: installing profile ${name}...`)
  const status = run(
    process.env.OMD_NPM || 'npm',
    ['install', '--omit=dev', '--no-audit', '--no-fund'],
    { cwd: directory },
  )
  if (status !== 0) fail(`profile ${name} dependency installation failed`, status)
}

function writeProfilePortable(name, bundles, mode) {
  const directory = join(dshHome, 'profiles', name)
  mkdirSync(directory, { recursive: true })

  const packagePath = join(directory, 'package.json')
  let current = {}
  if (existsSync(packagePath)) {
    try {
      current = JSON.parse(readFileSync(packagePath, 'utf8'))
    } catch (error) {
      fail(`cannot parse ${packagePath}: ${error.message}`)
    }
  }

  const omdVersion = mode.distributionInfo.omdVersion
  const next = {
    ...current,
    name: `dsh-profile-${name}`,
    private: true,
    type: 'module',
    dependencies: {
      ...(current.dependencies || {}),
      'oh-my-dsh': omdVersion,
      ...Object.fromEntries(
        profilePluginDependencies.map((dependency) => [
          dependency,
          manifest.dependencies[dependency],
        ]),
      ),
    },
    dsh: {
      ...(current.dsh || {}),
      profile: {
        ...(current.dsh?.profile || {}),
        bundles,
      },
    },
  }
  writeFileSync(packagePath, `${JSON.stringify(next, null, 2)}\n`)
  writeCordisPatch(directory)

  const target = portableNodeModulesTarget(mode)
  if (!existsSync(target)) {
    fail(`portable dependency closure is missing: ${target}`)
  }
  linkPortableNodeModules(directory, target)
  console.log(`omd: linked profile ${name} to portable dependency closure`)
}

function ensureBuilt() {
  if (!sourceCheckout()) return
  console.log('omd: installing and building the source checkout...')
  const packageManager = process.env.OMD_PACKAGE_MANAGER || 'pnpm'
  let status = run(packageManager, ['install'], { cwd: packageRoot })
  if (status !== 0) fail('dependency installation failed', status)
  status = run(packageManager, ['run', 'build'], { cwd: packageRoot })
  if (status !== 0) fail('build failed', status)
}

function setup() {
  const mode = distributionContext()
  if (mode.mode === 'portable') {
    for (const [name, bundles] of Object.entries(profiles)) {
      writeProfilePortable(name, bundles, mode)
    }
    console.log(`omd: profiles linked under ${join(dshHome, 'profiles')}`)
    return
  }
  ensureBuilt()
  for (const [name, bundles] of Object.entries(profiles)) writeProfile(name, bundles)
  console.log(`omd: profiles installed under ${join(dshHome, 'profiles')}`)
}

function profileReady(name) {
  return existsSync(join(dshHome, 'profiles', name, 'node_modules', 'oh-my-dsh'))
}

function ensureProfile(name) {
  if (!profileReady(name)) {
    console.log(`omd: profile ${name} is not installed; setting it up now.`)
    setup()
  }
}

function dshBin() {
  if (process.env.OMD_DSH) {
    const candidate = resolve(process.env.OMD_DSH, 'apps', 'cli', 'src', 'bin.ts')
    if (!existsSync(candidate))
      fail(`OMD_DSH is not a DeepSeek Harness checkout: ${process.env.OMD_DSH}`)
    return {
      command: process.env.OMD_PNPM || 'pnpm',
      prefix: ['-C', resolve(process.env.OMD_DSH), 'dsh'],
    }
  }
  const packagePath = require.resolve('@deepseek-ai/dsh/package.json')
  return {
    command: process.execPath,
    prefix: [join(dirname(packagePath), 'lib', 'bin.js')],
  }
}

function runDsh(profile, args) {
  ensureProfile(profile)
  const dsh = dshBin()
  const status = run(dsh.command, [...dsh.prefix, '--profile', profile, ...args])
  process.exit(status)
}

function doctorWebFetch() {
  if (process.env.OMD_DISABLE_WEB_FETCH === '1') {
    console.log(
      'web fetch: disabled (OMD_DISABLE_WEB_FETCH=1); shell fetches of public URLs prompt for approval',
    )
    return
  }
  const provider = process.env.DSH_WEB_FETCH_PROVIDER || 'omd-safe'
  if (provider === 'omd-safe') {
    const allowPrivate = process.env.OMD_WEB_FETCH_ALLOW_PRIVATE === '1'
    console.log(
      `web fetch: enabled, hardened provider (private networks ${allowPrivate ? 'ALLOWED via OMD_WEB_FETCH_ALLOW_PRIVATE' : 'blocked'})`,
    )
  } else if (provider === 'http') {
    console.log(
      'web fetch: enabled, upstream http provider — WARNING: no private-network (SSRF) protection',
    )
  } else {
    console.log(`web fetch: enabled, custom provider "${provider}"`)
  }
}

// Factual report of Node TCP listeners reachable beyond loopback. Upstream
// dsh already rejects `--host 0.0.0.0` and gates named binds behind trusted
// hosts; this survives config drift by inspecting what actually listens.
function doctorListeners() {
  if (process.platform !== 'darwin' && process.platform !== 'linux') return
  const result = spawnSync('lsof', ['-nP', '-iTCP', '-sTCP:LISTEN'], { encoding: 'utf8' })
  if (result.error || typeof result.stdout !== 'string' || result.stdout.length === 0) return
  const exposed = []
  for (const line of result.stdout.split('\n').slice(1)) {
    const columns = line.trim().split(/\s+/)
    if (columns.length < 9) continue
    const [command, pid] = columns
    if (command !== 'node') continue
    const name = columns.find((column) => /:[0-9]+$/.test(column))
    if (!name) continue
    const host = name.slice(0, name.lastIndexOf(':'))
    const loopback = host === '127.0.0.1' || host === '[::1]' || host === 'localhost'
    if (!loopback) exposed.push(`${name} (pid ${pid})`)
  }
  if (exposed.length === 0) {
    console.log('listeners: all Node TCP listeners are loopback-only')
  } else {
    console.log(`listeners: Node processes listening beyond loopback — ${exposed.join(', ')}`)
    console.log('  if one of these is dsh web, restart it without --host to stay loopback-only')
  }
}

async function doctor(args = []) {
  const mode = distributionContext()
  if (mode.mode === 'portable' && mode.distributionInfo) {
    console.log(formatDistributionIdentity(mode.distributionInfo))
  } else {
    console.log(`oh-my-dsh ${manifest.version}`)
  }
  console.log(`mode: ${mode.mode}`)
  console.log(`Node: ${process.version}`)
  console.log(`DSH_HOME: ${dshHome}`)
  for (const name of Object.keys(profiles)) {
    console.log(`${name}: ${profileReady(name) ? 'installed' : 'missing'}`)
  }
  try {
    console.log(`dsh: ${require('@deepseek-ai/dsh/package.json').version}`)
  } catch {
    console.log('dsh: missing')
  }
  doctorWebFetch()
  doctorListeners()

  if (args.includes('--verify')) {
    if (mode.mode !== 'portable' || !mode.distributionRoot) {
      console.log('file manifest: skipped (portable distribution only)')
      return
    }
    const manifestPath = join(mode.distributionRoot, 'distribution-files.json')
    if (!existsSync(manifestPath)) {
      console.log('file manifest: missing distribution-files.json')
      return
    }
    let fileManifest
    try {
      fileManifest = JSON.parse(readFileSync(manifestPath, 'utf8'))
    } catch (error) {
      console.log(`file manifest: cannot parse distribution-files.json (${error.message})`)
      return
    }
    const result = await verifyFileManifest(mode.distributionRoot, fileManifest)
    if (result.ok) {
      console.log('file manifest: ok')
      return
    }
    console.log('file manifest: FAILED')
    if (result.missing.length) console.log(`  missing: ${result.missing.join(', ')}`)
    if (result.mismatches.length) console.log(`  mismatches: ${result.mismatches.join(', ')}`)
    if (result.extra.length) console.log(`  extra: ${result.extra.join(', ')}`)
  }
}

function rollback() {
  const mode = distributionContext()
  if (mode.mode !== 'portable') {
    console.log('omd: rollback in npm/source mode is managed through npm.')
    console.log('  npm install -g oh-my-dsh@<version>')
    return
  }
  const installRoot = resolveInstallRoot(mode)
  if (!installRoot) fail('cannot determine portable install root (set OMD_INSTALL_ROOT)')

  reconcileTransactions(installRoot)
  const lock = acquireInstallLock(installRoot)
  try {
    const result = rollbackToPreviousVersion(installRoot)
    console.log(`omd: rolled back from ${result.from} to ${result.to}`)
    console.log('omd: run `omd rollback` again to reverse this rollback when needed.')
  } finally {
    lock.release()
  }
}

function sha256File(filePath) {
  return createHash('sha256').update(readFileSync(filePath)).digest('hex')
}

async function fetchReleaseManifest() {
  if (process.env.OMD_RELEASE_MANIFEST_PATH) {
    return parseReleaseManifest(
      readFileSync(resolve(process.env.OMD_RELEASE_MANIFEST_PATH), 'utf8'),
    )
  }
  const response = await fetch(RELEASE_MANIFEST_URL)
  if (!response.ok) {
    fail(`failed to fetch release manifest (${response.status} ${response.statusText})`)
  }
  return parseReleaseManifest(await response.text())
}

async function downloadToFile(url, destination) {
  const response = await fetch(url)
  if (!response.ok) {
    fail(`failed to download artifact (${response.status} ${response.statusText})`)
  }
  if (!response.body) fail('download response has no body')
  mkdirSync(dirname(destination), { recursive: true })
  await pipeline(response.body, createWriteStream(destination))
}

function validateArchiveEntries(entries) {
  for (const entry of entries) {
    if (!entry || entry === './') continue
    if (entry.startsWith('/') || entry.startsWith('../') || entry.includes('/../')) {
      fail(`unsafe archive entry: ${entry}`)
    }
  }
}

function listTarEntries(archivePath) {
  const result = spawnSync('tar', ['-tzf', archivePath], { encoding: 'utf8' })
  if (result.status !== 0) {
    fail(`cannot inspect archive: ${result.stderr || result.stdout}`)
  }
  return result.stdout.split('\n').filter(Boolean)
}

function extractTarArchive(archivePath, destination) {
  validateArchiveEntries(listTarEntries(archivePath))
  mkdirSync(destination, { recursive: true })
  const result = spawnSync('tar', ['-xzf', archivePath, '-C', destination], { encoding: 'utf8' })
  if (result.status !== 0) {
    fail(`archive extraction failed: ${result.stderr || result.stdout}`)
  }
}

function findExtractedVersionDir(stagingDir) {
  if (existsSync(join(stagingDir, 'distribution.json'))) return stagingDir
  const entries = readdirSync(stagingDir).filter((entry) => !entry.startsWith('.'))
  if (entries.length === 1) {
    const candidate = join(stagingDir, entries[0])
    if (existsSync(join(candidate, 'distribution.json'))) return candidate
  }
  fail('cannot locate extracted portable version directory')
}

function runPortableHealthCheck(versionDir) {
  const nodeBin = join(versionDir, 'runtime', 'bin', 'node')
  const omdBin = join(versionDir, 'app', 'bin', 'omd')
  if (!existsSync(omdBin)) fail(`health check failed: missing ${omdBin}`)
  const command = existsSync(nodeBin) ? nodeBin : process.execPath
  const result = spawnSync(command, [omdBin, '--version'], {
    encoding: 'utf8',
    env: {
      ...process.env,
      PATH: '',
      HOME: process.env.HOME || homedir(),
    },
  })
  if (result.status !== 0) {
    fail(`health check failed: ${result.stderr || result.stdout || 'non-zero exit'}`)
  }
  return String(result.stdout || '').trim()
}

async function update() {
  const mode = distributionContext()
  if (mode.mode !== 'portable') {
    console.log('omd: updates in npm/source mode are managed through npm.')
    console.log('  npm install -g oh-my-dsh@latest')
    return
  }

  const installRoot = resolveInstallRoot(mode)
  if (!installRoot) fail('cannot determine portable install root (set OMD_INSTALL_ROOT)')

  reconcileTransactions(installRoot)
  const lock = acquireInstallLock(installRoot)
  let stagingDir = null

  try {
    const releaseManifest = await fetchReleaseManifest()
    const platform = normalizePlatform()
    const artifact = findArtifactForPlatform(releaseManifest, platform)
    const state = readInstallState(installRoot)
    const currentVersion =
      state.currentVersion || mode.distributionInfo?.omdVersion || manifest.version

    console.log(`omd: current ${currentVersion}, candidate ${releaseManifest.omdVersion}`)
    if (currentVersion === releaseManifest.omdVersion) {
      console.log('omd: already up to date')
      return
    }

    stagingDir = mkdtempSync(join(tmpdir(), 'omd-update-staging-'))
    const archivePath = join(stagingDir, artifact.filename)
    await downloadToFile(artifact.url, archivePath)

    const digest = sha256File(archivePath)
    if (digest !== artifact.sha256) {
      fail(`artifact checksum mismatch (expected ${artifact.sha256}, got ${digest})`)
    }

    const extractDir = join(stagingDir, 'extract')
    extractTarArchive(archivePath, extractDir)
    const versionDir = findExtractedVersionDir(extractDir)
    runPortableHealthCheck(versionDir)

    const targetDir = join(installRoot, 'versions', releaseManifest.omdVersion)
    rmSync(targetDir, { recursive: true, force: true })
    renameSync(versionDir, targetDir)
    stagingDir = null

    beginInstallTransaction(installRoot, {
      op: 'update',
      candidateVersion: releaseManifest.omdVersion,
      oldCurrent: currentVersion,
      oldPrevious: state.previousVersion,
    })
    commitInstallTransaction(installRoot, releaseManifest.omdVersion, {
      sha256: artifact.sha256,
      url: artifact.url,
      platform: artifact.platform,
    })

    console.log(`omd: updated to ${releaseManifest.omdVersion}`)
    console.log('omd: run `omd rollback` to return to the previous version if needed.')
  } finally {
    lock.release()
    if (stagingDir) rmSync(stagingDir, { recursive: true, force: true })
  }
}

function readOmdConfig() {
  if (!existsSync(omdConfigPath)) return { presets: [] }
  try {
    const value = JSON.parse(readFileSync(omdConfigPath, 'utf8'))
    return {
      ...value,
      presets: Array.isArray(value.presets)
        ? value.presets.filter((item) => typeof item === 'string')
        : [],
    }
  } catch (error) {
    fail(`cannot parse ${omdConfigPath}: ${error.message}`)
  }
}

function writeOmdConfig(config) {
  mkdirSync(dirname(omdConfigPath), { recursive: true })
  writeFileSync(omdConfigPath, `${JSON.stringify(config, null, 2)}\n`, { mode: 0o600 })
}

function workspaceRoot(path) {
  let current = resolve(path)
  while (true) {
    if (existsSync(join(current, '.git'))) return current
    const parent = dirname(current)
    if (parent === current) return resolve(path)
    current = parent
  }
}

function preset(args) {
  const [action = 'list', name] = args
  const config = readOmdConfig()
  if (action === 'list') {
    for (const [id, description] of Object.entries(presetCatalog)) {
      console.log(`${config.presets.includes(id) ? '✓' : '○'} ${id.padEnd(12)} ${description}`)
    }
    return
  }
  if (!['enable', 'disable'].includes(action) || !name) {
    fail('usage: omd preset [list | enable <name> | disable <name>]', 2)
  }
  if (!(name in presetCatalog)) fail(`unknown preset "${name}"`, 2)
  const selected = new Set(config.presets)
  if (action === 'enable') selected.add(name)
  else selected.delete(name)
  writeOmdConfig({ ...config, presets: [...selected].sort() })
  console.log(`omd: ${name} ${action === 'enable' ? 'enabled' : 'disabled'}; restart omd to apply.`)
}

function trust(args) {
  const [action = 'list', path = process.cwd()] = args
  const config = readOmdConfig()
  const trusted = new Set(
    Array.isArray(config.trustedWorkspaces)
      ? config.trustedWorkspaces
          .filter((item) => typeof item === 'string')
          .map((item) => resolve(item))
      : [],
  )
  if (action === 'list') {
    if (!trusted.size) {
      console.log('No trusted workspaces.')
      return
    }
    for (const workspace of [...trusted].sort()) console.log(workspace)
    return
  }
  if (!['add', 'remove'].includes(action)) {
    fail('usage: omd trust [list | add [path] | remove [path]]', 2)
  }
  const workspace = workspaceRoot(path)
  if (action === 'add') trusted.add(workspace)
  else trusted.delete(workspace)
  writeOmdConfig({ ...config, trustedWorkspaces: [...trusted].sort() })
  console.log(
    `omd: ${workspace} ${action === 'add' ? 'trusted' : 'untrusted'}; restart omd to apply.`,
  )
}

function zstdFrameRanges(bytes) {
  const magic = 0xfd2fb528
  const frames = []
  let offset = 0
  while (offset < bytes.length) {
    const start = offset
    if (bytes.length - offset < 4) break
    if (bytes.readUInt32LE(offset) !== magic) {
      throw new Error(`invalid Zstandard frame magic at byte ${offset}`)
    }
    offset += 4
    if (offset === bytes.length) break
    const descriptor = bytes.readUInt8(offset++)
    if ((descriptor & 0x18) !== 0) {
      throw new Error(`invalid Zstandard frame descriptor at byte ${offset - 1}`)
    }
    const contentSizeFlag = descriptor >>> 6
    const singleSegment = (descriptor & 0x20) !== 0
    const checksum = (descriptor & 0x04) !== 0
    const dictionaryFlag = descriptor & 0x03
    const dictionaryBytes = dictionaryFlag === 3 ? 4 : dictionaryFlag
    const contentSizeBytes = contentSizeFlag === 0 ? (singleSegment ? 1 : 0) : 1 << contentSizeFlag
    const remainingHeaderBytes = (singleSegment ? 0 : 1) + dictionaryBytes + contentSizeBytes
    if (bytes.length - offset < remainingHeaderBytes) break
    offset += remainingHeaderBytes
    let complete = false
    for (;;) {
      if (bytes.length - offset < 3) break
      const blockHeader = bytes.readUIntLE(offset, 3)
      offset += 3
      const lastBlock = (blockHeader & 1) !== 0
      const blockType = (blockHeader >>> 1) & 3
      if (blockType === 3) throw new Error(`reserved Zstandard block type at byte ${offset - 3}`)
      const blockSize = blockHeader >>> 3
      const payloadBytes = blockType === 1 ? 1 : blockSize
      if (bytes.length - offset < payloadBytes) break
      offset += payloadBytes
      if (!lastBlock) continue
      if (checksum) {
        if (bytes.length - offset < 4) break
        offset += 4
      }
      complete = true
      break
    }
    if (!complete) break
    frames.push({ start, end: offset })
  }
  return frames
}

function decompressZstd(bytes) {
  const frames = zstdFrameRanges(bytes)
  if (!frames.length) throw new Error('empty or incomplete Zstandard session log')
  return Buffer.concat(
    frames.map(({ start, end }) => zstdDecompressSync(bytes.subarray(start, end))),
  )
}

async function usageReport() {
  const root = join(dshHome, 'sessions')
  const files = []
  const walk = (directory) => {
    if (!existsSync(directory)) return
    for (const entry of readdirSync(directory)) {
      const path = join(directory, entry)
      let info
      try {
        info = statSync(path)
      } catch {
        continue
      }
      if (info.isDirectory()) walk(path)
      else if (info.isFile() && (path.endsWith('.jsonl') || path.endsWith('.jsonl.zstd'))) {
        files.push(path)
      }
    }
  }
  walk(root)
  const total = {
    sessions: files.length,
    calls: 0,
    inputTokens: 0,
    outputTokens: 0,
    cacheReadTokens: 0,
    cacheWriteTokens: 0,
    reasoningTokens: 0,
  }
  const { decodeStorageRecord } = await import('@deepseek-ai/dsh-session')
  for (const file of files) {
    const usages = new Map()
    let content
    try {
      const bytes = readFileSync(file)
      content = file.endsWith('.zstd')
        ? decompressZstd(bytes).toString('utf8')
        : bytes.toString('utf8')
    } catch {
      continue
    }
    for (const line of content.split('\n').slice(1)) {
      if (!line) continue
      try {
        const record = JSON.parse(line)
        for (const event of decodeStorageRecord(record)) {
          const key = `${event.data?.turn}:${event.data?.step}`
          if (event.type === 'assistant/chunk' && event.data?.chunk?.type === 'usage') {
            usages.set(key, event.data.chunk.usage)
          } else if (event.type === 'assistant/message' && event.data?.usage) {
            usages.set(key, event.data.usage)
          }
        }
      } catch {
        // A malformed line belongs to persistence diagnostics; usage remains
        // best-effort and never mutates session data.
      }
    }
    for (const usage of usages.values()) {
      total.calls += 1
      total.inputTokens += usage.inputTokens || 0
      total.outputTokens += usage.outputTokens || 0
      total.cacheReadTokens += usage.cacheReadTokens || 0
      total.cacheWriteTokens += usage.cacheWriteTokens || 0
      total.reasoningTokens += usage.reasoningTokens || 0
    }
  }
  const format = new Intl.NumberFormat('en-US')
  console.log(`Saved sessions: ${format.format(total.sessions)}`)
  console.log(`Model calls: ${format.format(total.calls)}`)
  console.log(`Input tokens: ${format.format(total.inputTokens)}`)
  console.log(`Output tokens: ${format.format(total.outputTokens)}`)
  console.log(`Reasoning tokens: ${format.format(total.reasoningTokens)}`)
  console.log(`Cache read: ${format.format(total.cacheReadTokens)}`)
  console.log(`Cache write: ${format.format(total.cacheWriteTokens)}`)
  console.log('Estimated cost: unavailable (dsh adapters do not expose provider-neutral pricing).')
}

function usage() {
  console.log(`oh-my-dsh ${manifest.version} — an opinionated DeepSeek Harness distribution

Usage:
  omd                         Start the Web UI with the omd profile
  omd setup                   Install or upgrade the omd profiles
  omd update                  Check for and install a newer portable release
  omd rollback                Switch portable install back to the previous version
  omd web [options]           Start the Web UI
  omd headless "task"         Run one headless task
  omd config                  Print the composed omd Web configuration
  omd doctor [--verify]       Check installation and profile status
  omd preset [list|enable|disable]
                              Manage curated MCP presets
  omd trust [list|add|remove] Manage workspaces allowed to run imported integrations
  omd usage                   Sum token usage from saved sessions
  omd dsh [arguments...]      Invoke the underlying dsh CLI directly

Environment:
  DSH_HOME                    Harness home (default: ~/.dsh)
  OMD_INSTALL_ROOT            Portable install root (default: derived from layout)
  OMD_MANIFEST_URL            Override release manifest URL for portable update
  OMD_RELEASE_MANIFEST_PATH   Local release-manifest.json path (testing/offline)
  OMD_DSH                     Optional DeepSeek Harness source checkout
  OMD_NPM / OMD_PNPM          Package-manager command overrides
  OMD_PACKAGE_MANAGER         Source-checkout package manager (default: pnpm)
`)
}

const [command = 'web', ...args] = process.argv.slice(2)
switch (command) {
  case 'setup':
    setup()
    break
  case 'web':
    runDsh('omd', args)
    break
  case 'headless':
    runDsh('omd-headless', args)
    break
  case 'config':
    runDsh('omd', ['--dump-config', ...args])
    break
  case 'doctor':
    await doctor(args)
    break
  case 'update':
    await update()
    break
  case 'rollback':
    rollback()
    break
  case 'preset':
    preset(args)
    break
  case 'trust':
    trust(args)
    break
  case 'usage':
    await usageReport()
    break
  case 'dsh': {
    const dsh = dshBin()
    process.exit(run(dsh.command, [...dsh.prefix, ...args]))
  }
  case 'help':
  case '--help':
  case '-h':
    usage()
    break
  case '--version':
  case '-v':
    console.log(manifest.version)
    break
  default:
    fail(`unknown command "${command}" (run "omd help")`, 2)
}
